# ── Agentic OS API configuration ────────────────────────────────────────────
# Copy to .env (repo root or apps/api). Everything is optional — with no
# config the kernel boots on the zero-dependency local drivers:
#   DB    → node:sqlite file at data/agentic.db
#   BROKER→ in-process pub/sub
#   MODELS→ the built-in deterministic provider (planner/summarizer)

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Data layer — set to Postgres to use the Postgres driver (docker-compose provides one)
# DATABASE_URL=postgres://agentic:agentic@localhost:5432/agentic

# Event broker — set to Redis for cross-process pub/sub (optional)
# REDIS_URL=redis://localhost:6379

# OpenAI-compatible provider (works with OpenAI, Groq, Together, OpenRouter, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Ollama local models
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Google Gemini (Generative Language API)
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro   (optional; auto-discovered when empty)

# Autonomy gate: seconds an agent waits for human approval before timing out
APPROVAL_TIMEOUT_S=300

# First-boot admin account (only used if the users table is empty)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123

# Opt-in: allow the shell.run tool to execute whitelisted commands (high risk, always approval-gated)
AGENTIC_ALLOW_SHELL=0

# Phase 3 runtime policies
AGENTIC_STEP_RETRIES=1          # retries per failed step (exponential backoff 250ms * 2^n)
AGENTIC_MAX_DELEGATION_DEPTH=2  # max agent→agent delegation nesting

# ── Phase 5: semantic memory ─────────────────────────────────────────────────
# Embedding provider (defaults to the deterministic local hash-128 — zero deps).
# OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Phase 9: integration vault ───────────────────────────────────────────────
# Auto-generated 0600 key file at data/vault.key when unset — set to move/rotate.
# INTEGRATION_VAULT_KEY=base64-of-32-bytes

# ── Phase 10: browser push (Web Push, RFC 8291/8292) ─────────────────────────
# Auto-generated keypair persisted to data/vapid.json when unset.
# VAPID_PUBLIC_KEY=base64url-65B-uncompressed-point
# VAPID_PRIVATE_KEY=base64url-32B-scalar
# VAPID_SUBJECT=mailto:you@example.com

# ── Phase 12 ──────────────────────────────────────────────────────────────────
# Hot-loadable skill definitions directory (defaults to <repo>/skills)
# AGENTIC_SKILLS_DIR=./skills
