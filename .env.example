# ── Agentic OS API configuration ────────────────────────────────────────────
# Copy to .env (repo root or apps/api). Everything is optional — with no
# config the kernel boots on the zero-dependency local drivers:
#   DB    → node:sqlite file at data/agentic.db
#   BROKER→ in-process pub/sub
#   MODELS→ the built-in deterministic provider (planner/summarizer)

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Data layer — set to Postgres to use the Postgres driver (docker-compose provides one)
# DATABASE_URL=postgres://agentic:agentic@localhost:5432/agentic

# Event broker — set to Redis for cross-process pub/sub (optional)
# REDIS_URL=redis://localhost:6379

# OpenAI-compatible provider (works with OpenAI, Groq, Together, OpenRouter, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Ollama local models
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Autonomy gate: seconds an agent waits for human approval before timing out
APPROVAL_TIMEOUT_S=300

# First-boot admin account (only used if the users table is empty)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123

# Opt-in: allow the shell.run tool to execute whitelisted commands (high risk, always approval-gated)
AGENTIC_ALLOW_SHELL=0
